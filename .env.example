HOMEGANTRY_PORT=3000
HOMEGANTRY_HOST=
HOMEGANTRY_TITLE=HomeGantry
HOMEGANTRY_DOCKER_SOCKET=/var/run/docker.sock
HOMEGANTRY_POLL_INTERVAL=60
HOMEGANTRY_SHOW_STOPPED=false
HOMEGANTRY_HOMEPAGE_COMPAT=true
HOMEGANTRY_EXCLUDE_SELF=true
HOMEGANTRY_COMPOSE_ONLY=true
HOMEGANTRY_DATA_DIR=/data
HOMEGANTRY_LOG_LEVEL=info
# ---- security (see docs/guide/security.md); leave empty for a read-only dashboard ----
# Admin token for "Unlock editing" (at least 24 characters; generate with: openssl rand -hex 32)
HOMEGANTRY_ADMIN_TOKEN=
# Forward-auth header set by your proxy (e.g. Remote-User) and the proxy's IPs/CIDRs
HOMEGANTRY_AUTH_HEADER=
HOMEGANTRY_TRUSTED_PROXIES=
HOMEGANTRY_READONLY=false
HOMEGANTRY_CORS_ORIGINS=
# Docker API via a read-only socket proxy instead of the socket (e.g. tcp://socket-proxy:2375)
DOCKER_HOST=
# ---- Traefik discovery (see docs/guide/traefik.md); keep the API on an internal network ----
# e.g. http://traefik:8080
HOMEGANTRY_TRAEFIK_API_URL=
HOMEGANTRY_TRAEFIK_API_USERNAME=
HOMEGANTRY_TRAEFIK_API_PASSWORD=
HOMEGANTRY_TRAEFIK_API_TOKEN=
HOMEGANTRY_TRAEFIK_TIMEOUT=5
# Middleware to exposure level, e.g. my-sso=sso,office-*=vpn-only
HOMEGANTRY_EXPOSURE_MAP=
# ---- HTTP health checks (see docs/guide/health-checks.md) ----
HOMEGANTRY_HEALTHCHECK=true
HOMEGANTRY_HEALTHCHECK_INTERVAL=60
HOMEGANTRY_HEALTHCHECK_TIMEOUT=5
HOMEGANTRY_HEALTHCHECK_CONCURRENCY=8
HOMEGANTRY_HEALTHCHECK_INSECURE_TLS=false
